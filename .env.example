# FoodLoop Environment Configuration
# Ministry of Food Processing Industries (MoFPI) - SIH 2026 (SIH26234)

# Environment Mode: 'development' or 'production'
ENV=development

# Database
# In production (Render PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://<username>:<password>@<internal_host>:5432/<database_name>
# In local development (SQLite fallback):
DATABASE_URL=sqlite+aiosqlite:///./foodloop.db

# JWT Security
# In production, this must be a cryptographically secure 64-char random secret.
SECRET_KEY=generate_a_64_char_hex_secret_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated or JSON array)
# e.g., http://localhost:3000,https://foodloop-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# API Keys (Optional with built-in fallbacks)
CALENDARIFIC_API_KEY=
ELECTRICITY_MAPS_API_KEY=
GEMINI_API_KEY=

# Emission & Impact Benchmark Factors (IPCC / CEA / WRAP)
INDIA_GRID_EMISSION_FACTOR=0.716  # kg CO2e / kWh (CEA Baseline v19)
FOOD_WASTE_EMISSION_FACTOR=2.5    # kg CO2e / kg food waste (WRAP / IPCC)
FOOD_WASTE_WATER_FACTOR=1000.0    # Litres of water / kg food waste (FAO)

# Demo Institution Coordinates (Pune Corridor)
DEMO_INSTITUTION_LAT=18.5204
DEMO_INSTITUTION_LNG=73.8567
DEMO_INSTITUTION_CITY=Pune
DEMO_INSTITUTION_STATE=Maharashtra

# Server Port
PORT=8000
HOST=0.0.0.0

# Frontend Environment Variables (Set in Vercel)
# NEXT_PUBLIC_API_URL=https://<your-render-api>.onrender.com
# NEXT_PUBLIC_WS_URL=wss://<your-render-api>.onrender.com
